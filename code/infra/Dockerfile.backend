FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /app

COPY pom.xml .
COPY src ./src

# The build also checks the licenses of all dependencies (it fails on violations)
# and generates the license notices (license-maven-plugin, see pom.xml).
RUN mvn clean package -DskipTests

FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=build /app/target/*.jar app.jar
COPY --from=build /app/target/generated-sources/license/THIRD_PARTY_LICENSES.txt /usr/share/doc/asz-management-suite/THIRD_PARTY_LICENSES.txt

RUN chown -R ubuntu:ubuntu /app
USER ubuntu

EXPOSE 8080

CMD ["java", "-jar", "app.jar"]